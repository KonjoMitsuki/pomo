## 3. ソースコードの変更内容

非同期リクエストを行うために、`discord.py` に内蔵されている `aiohttp` ライブラリを使用します。

### 3.1 `src/audio.py` の変更
従来の固定ファイルを再生する仕組みから、VOICEVOX APIを叩いて一時ファイル `voicevox_temp.wav` を作成して再生する仕組みへリファクタリングします。

```python
from __future__ import annotations

import asyncio
from pathlib import Path
import aiohttp
import discord

DEFAULT_ASSETS_DIR = Path(__file__).resolve().parent.parent / "assets"
TEMP_SOUND_FILE = str(DEFAULT_ASSETS_DIR / "voicevox_temp.wav")

class AudioPlayer:
    def __init__(self, voicevox_url: str = "http://127.0.0.1:50021", speaker_id: int = 47):
        """
        voicevox_url: VOICEVOXエンジンのURL
        speaker_id: キャラクターのスピーカーID (47 = ナースロボ＿タイプＴ ノーマル)
        """
        self.voicevox_url = voicevox_url
        self.speaker_id = speaker_id
        self.temp_file = TEMP_SOUND_FILE

    async def generate_voice(self, text: str) -> bool:
        """VOICEVOX APIを呼び出して音声ファイルを生成し、一時保存する"""
        try:
            async with aiohttp.ClientSession() as session:
                # 1. 音声合成クエリの作成
                params = {"text": text, "speaker": self.speaker_id}
                async with session.post(f"{self.voicevox_url}/audio_query", params=params) as resp:
                    if resp.status != 200:
                        print(f"[ERROR] audio_query 失敗: status={resp.status}")
                        return False
                    query_json = await resp.json()

                # 2. 音声合成の実行
                headers = {"Content-Type": "application/json"}
                async with session.post(
                    f"{self.voicevox_url}/synthesis",
                    params={"speaker": self.speaker_id},
                    json=query_json,
                    headers=headers
                ) as resp:
                    if resp.status != 200:
                        print(f"[ERROR] synthesis 失敗: status={resp.status}")
                        return False
                    data = await resp.read()

                # 3. 一時ファイルにバイナリを書き込み
                with open(self.temp_file, "wb") as f:
                    f.write(data)
                return True
        except Exception as e:
            print(f"[ERROR] VOICEVOX API接続エラー: {e}")
            return False

    async def play_voice(self, voice_client: discord.VoiceClient, text: str, volume: float = 1.0) -> None:
        """テキストをナースロボ＿タイプＴの音声に変換してボイスチャンネルで再生する"""
        # API経由で音声を生成
        success = await self.generate_voice(text)
        if not success:
            print(f"[WARNING] 音声生成に失敗したため、再生をスキップします。")
            return

        if voice_client.is_playing():
            voice_client.stop()

        # 生成されたWAVファイルを再生
        audio_source = discord.FFmpegPCMAudio(
            self.temp_file,
            options=f'-filter:a "volume={volume}"',
        )
        voice_client.play(audio_source)
        
        # 再生完了まで待機 (最大15秒)
        for _ in range(150):
            if not voice_client.is_playing():
                break
            await asyncio.sleep(0.1)
```

